[Unit]
Description=NEXUS restricted bot updater
Requires=docker.service
After=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/nexus-updater/updater.py
Restart=on-failure
UMask=0077
RuntimeDirectory=nexus-updater
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ReadWritePaths=/opt/nexus-updater /run/nexus-updater
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
