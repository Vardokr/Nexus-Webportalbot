[Unit]
Description=NEXUS Watchdog Bot v3
Documentation=https://github.com/dein-repo
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# Sicherheit: Eigenen User verwenden (nicht root!)
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus-bot

# .env Datei laden
# dotenv loads .env directly; systemd parsing would alter embedded JSON quotes.

# Node.js Prozess
ExecStart=/usr/bin/node nexus-bot.js

# Automatisch neustarten bei Crash
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Logs via systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexus-bot

# Prozess-Limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
