# ============================================
# NEXUS WATCHDOG v3 - Konfiguration
# ============================================
# WICHTIG: Diese Datei NIEMALS in Git hochladen!
# Füge ".env" zu deiner .gitignore hinzu.

# ============================================
# FIREBASE (PFLICHT)
# ============================================
# Den gesamten Inhalt deiner serviceAccountKey.json
# als einzeiligen JSON-String einfügen:
# (Zeilenumbrüche in private_key als \n belassen)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"DEIN_PROJEKT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://DEIN_PROJEKT-default-rtdb.firebaseio.com

# ============================================
# WARGAMING API (PFLICHT)
# ============================================
WG_API_KEY=DEIN_WG_API_KEY_HIER

# ============================================
# DISCORD (OPTIONAL)
# ============================================
DISCORD_WEBHOOK=https://discord.com/api/webhooks/DEINE_WEBHOOK_URL

# ============================================
# DASHBOARD LOGIN (PFLICHT)
# ============================================
DASHBOARD_USER=admin

# Option A: Klartext-Passwort (mindestens 12 Zeichen empfohlen)
DASHBOARD_PASS=

# Option B: scrypt-Hash (empfohlen; install.sh erzeugt ihn interaktiv)
# DASHBOARD_PASS_HASH=scrypt:SALT:HASH
# Alte SHA-256-Hashes bleiben kompatibel:
# Hash generieren: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('DEIN_PASSWORT').digest('hex'))"
# DASHBOARD_PASS_HASH=DEIN_SHA256_HASH_HIER
# Wenn DASHBOARD_PASS_HASH gesetzt ist, wird DASHBOARD_PASS ignoriert.

# ============================================
# SCANNER KONFIGURATION
# ============================================
CLAN_ID=ODIN
SCAN_INTERVAL=120

# ============================================
# DASHBOARD SERVER
# ============================================
DASHBOARD_PORT=3000
# Standard: 127.0.0.1 (nur lokal, nginx vorschalten)
# Für direkte Erreichbarkeit: 0.0.0.0 (NICHT empfohlen ohne HTTPS!)
DASHBOARD_HOST=127.0.0.1
# Bei HTTPS hinter einem Reverse Proxy (ohne abschließenden Schrägstrich):
# DASHBOARD_ORIGIN=https://watchdog.example.com
